# ── ASINs to monitor (comma-separated, no spaces) ────────────────────────────
ASINS=B0XXXXXXXXX,B0YYYYYYYYY

# ── Poll interval (seconds) — actual wait is a random value in this range ────
INTERVAL_MIN=300
INTERVAL_MAX=900

# ── Per-request HTTP delay (seconds) — randomised between these bounds ────────
REQUEST_DELAY_MIN=3.0
REQUEST_DELAY_MAX=7.0

# ── Discord webhook URL (paste your channel's webhook URL here) ───────────────
# Create one at: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# Send a startup ping to Discord when the monitor launches (true/false)
DISCORD_STARTUP_PING=true

# ── Proxy settings ────────────────────────────────────────────────────────────
# Path to file containing one proxy per line (leave blank to disable proxies)
PROXY_FILE=proxies.txt

# ── Storage ───────────────────────────────────────────────────────────────────
DB_PATH=amz_jp.db

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Leave LOG_FILE blank to log to stdout only
LOG_FILE=amz_monitor.log
