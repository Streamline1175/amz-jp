# Proxy list — one proxy per line.
# Lines starting with # are ignored.
#
# Supported formats:
#   host:port
#   user:pass@host:port
#   http://host:port
#   http://user:pass@host:port
#   socks5://user:pass@host:port
#
# Copy this file to proxies.txt and fill in your proxies.

# Example residential proxies:
# 192.0.2.10:8080
# proxy.example.com:3128
# user123:secret@gate.provider.com:10000
# socks5://user123:secret@gate.provider.com:1080
